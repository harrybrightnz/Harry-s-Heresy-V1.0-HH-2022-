    <selectionEntry name="Horus Aximand" id="7ed0-7d06-406c-abd9" page="190" publicationId="d882-d2a-5da1-92c4" type="unit">
      <categoryLinks>
        <categoryLink name="Unit:" id="59d3-27f7-43fe-9d46" primary="false" targetId="36c3-e85e-97cc-c503"/>
        <categoryLink name="HQ:" id="3e23-d3b6-4c17-8379" primary="false" targetId="4f85-eb33-30c9-8f51"/>
        <categoryLink name="Infantry Unit Type" id="63c1-1073-9ad0-d1fd" primary="false" targetId="8b4f-bfe2-ce7b-f1b1"/>
      </categoryLinks>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="170"/>
