      </entryLinks>
      <infoLinks>
        <infoLink name="Legiones Astartes (X)" id="0361-d368-4a46-9632" hidden="false" targetId="ffcb-13b4-9b4c-84da" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Legiones Astartes (Sons of Horus)"/>
          </modifiers>
        </infoLink>
