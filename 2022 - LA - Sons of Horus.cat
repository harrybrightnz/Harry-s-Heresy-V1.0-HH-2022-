      </constraints>
      <entryLinks>
        <entryLink name="Generic Warlord Traits" id="9714-3b10-54a0-01a4" collective="false" hidden="false" import="true" targetId="c064-819f-d9ef-1775" type="selectionEntryGroup"/>
      </entryLinks>
      <modifiers>
