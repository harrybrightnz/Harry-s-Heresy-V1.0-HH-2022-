    <selectionEntry name="Crimson Paladins" id="33fe-9683-bde5-95ca" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Infantry Unit Type" id="21ac-518e-b688-7692" hidden="false" primary="false" targetId="8b4f-bfe2-ce7b-f1b1"/>
