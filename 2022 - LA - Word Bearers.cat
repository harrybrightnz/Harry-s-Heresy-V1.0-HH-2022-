        <infoLink name="Hatred (X)" id="6c02-a57a-95b5-bc2d" hidden="false" targetId="dc0b-fe69-6b71-e0a4" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Hatred (Everything) (See &quot;Jealous Command&quot;)"/>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="0176-56a3-d590-b103" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="e61d-db78-6f56-3c05" shared="true" type="atLeast" value="1"/>
                    <condition childId="9289-65f7-e452-51a5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Jealous Command" id="94ed-f7c4-3c14-dacd" hidden="false">
          <description>If Kor Phaeron or Lorgar is not chosen as the Warlord of an army that Kor Phaeron is part of, then his Leadership is reduced by -1 and he gains the Hatred (Everything) special rule. When Kor Phaeron is included as the same army as Lorgar, both models gain +1 WS and the Hatred (Everything) special rules while part of the same unit.</description>
        </rule>
      </rules>
