        <entryLink name="Warlord" id="74da-bce0-f635-a5bb" collective="false" hidden="false" import="true" targetId="0176-56a3-d590-b103" type="selectionEntry">
          <constraints>
            <constraint id="d9b9-403b-0c76-ef8f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <rules>
            <rule name="The Eater of Wisdom" id="b2c4-083a-57e1-5b34" hidden="false">
              <description>If Zardu Layak is the army’s Warlord, then the controlling player may choose up to three friendly units composed entirely of models with the Corrupted Unit Sub-type from the same army as Zardu Layak at the beginning of the battle, before any models are deployed. All models in each of the selected units gains a bonus of +1 to its Strength and Movement Characteristics, but must take a Leadership test at the end of each of the controlling player’s turns. If that Test is failed the unit suffers Perils of the Warp, while if it is not failed there is no effect that turn. In addition, an army with Zardu Layak as its Warlord may make an additional Reaction during the opposing player’s Assault phase as long as Zardu Layak has not been removed as a casualty.&apos;</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Retinue" id="fa9b-e07e-79bd-bf59" collective="false" hidden="false" import="true" targetId="bda8-b52d-c914-4ac2" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Fearless" id="db32-9305-1735-81ce" hidden="false" targetId="b48c-d7e1-2a83-2f5b" type="rule"/>
        <infoLink name="Hatred (X)" id="3f82-2136-2167-9280" hidden="false" targetId="dc0b-fe69-6b71-e0a4" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Hatred (Loyalists)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Legiones Astartes (Word Bearers)" id="d324-8719-89c0-dd00" hidden="false" targetId="21ba-24fc-3fad-00fe" type="rule"/>
        <infoLink name="Relentless" id="8932-28c5-60c8-9155" hidden="false" targetId="7adf-ac9a-5035-522d" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Binder of Souls" id="243e-126c-9412-267b" hidden="false">
          <description>Zardu Layak gains the Psychic Discipline Soul Binding and may not select any other Psychic Discipline.</description>
        </rule>
        <rule name="Psychic Discipline: Soul Binding" id="710c-29df-c854-b207" hidden="true">
          <description>A Psyker with this Discipline gains all the listed Powers, Weapon and other special rules, as well as the Aetheric Lightning Psychic Weapon</description>
        </rule>
      </rules>
