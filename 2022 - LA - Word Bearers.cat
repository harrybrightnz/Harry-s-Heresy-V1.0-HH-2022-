          <modifiers>
            <modifier field="name" type="set" value="Feel No Pain (5+)"/>
          </modifiers>
        </infoLink>
        <infoLink name="It Will Not Die (X)" id="2a90-9fd3-91f8-b3a3" hidden="false" targetId="2784-d0be-a4e2-890f" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="It Will Not Die (5+)"/>
