            <selectionEntry name="Stratos Thrusters" id="163f-5b84-490b-b332" collective="false" hidden="false" import="true" page="130" publicationId="bde1-6db1-163b-3b76" type="upgrade">
              <constraints>
                <constraint id="11ec-0cf8-5dcd-9593" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="bd7c-394f-e7cf-3bc2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <profiles>
                <profile name="Stratos Thrusters" id="e90a-5837-2524-80f0" hidden="false" page="130" publicationId="bde1-6db1-163b-3b76" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit composed entirely of models with Stratos thrusters may set its Move Characteristic to a value of 16&quot; for the duration of the controlling player’s turn. This allows the unit to move up to 16&quot;, regardless of the Movement Characteristic shown on its profile and gain any other benefits of a Movement Characteristic of 16&quot; (including the bonus to Charge distance). In addition, Stratos thrusters allow units to hover above the battlefield and thus ignore the effects of Difficult Terrain and Dangerous Terrain at all times.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
