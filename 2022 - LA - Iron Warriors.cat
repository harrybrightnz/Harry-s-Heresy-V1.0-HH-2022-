      <selectionEntryGroups>
        <selectionEntryGroup name="IV: Iron Warriors" id="a031-a816-817c-c73b" collective="false" hidden="true" import="true" page="176" publicationId="09c5-eeae-f398-b653">
          <constraints>
            <constraint id="73e6-5358-f9ff-c611" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="baa1-4eb5-a1c1-76cc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
