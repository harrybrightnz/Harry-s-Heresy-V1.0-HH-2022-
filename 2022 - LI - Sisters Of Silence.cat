                <infoLink name="Preferred Enemy (X)" id="65d-bc9d-708a-1a51" hidden="false" targetId="37ab-d4db-891a-de8c" type="rule">
                  <modifiers>
                    <modifier field="name" type="set" value="Preferred Enemy (Psykers, Daemons and Corrupted)"/>
