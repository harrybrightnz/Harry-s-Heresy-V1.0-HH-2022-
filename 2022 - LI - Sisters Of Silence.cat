    <selectionEntry name="Compression Tanks" id="3ac3-045d-bc0e-d7fe" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
      <profiles>
        <profile name="Compression Tanks" id="91b3-fe6a-cc45-f0a7" hidden="false" page="153" publicationId="15a4-fc68-502d-48a9" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Compression tanks may be used once per battle, this use must be declared when the controlling player declares a Shooting Attack for a unit that includes one or more models with compression tanks, before any To Hit rolls are made. When used, all models with compression tanks increase the Strength of any Flame weapons they have by +2 for the duration of that Shooting Attack – and when used, all models in the unit with compression tanks must use them. Once that Shooting Attack is fully resolved, all compression tanks in the attacking unit are expended and may not be used again in that battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
