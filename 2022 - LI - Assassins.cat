          <characteristics>
            <characteristic name="Unit Type" typeId="ddd7-6f5c-a939-b69e">Infantry (Character, Assassin, Light)</characteristic>
            <characteristic name="Move" typeId="893e-2d76-8f04-44e5">7</characteristic>
