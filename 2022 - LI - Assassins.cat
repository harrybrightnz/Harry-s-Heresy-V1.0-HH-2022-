            </infoLink>
            <infoLink name="Template Weapons" id="6e4f-b76c-74ec-f7c6" hidden="false" targetId="5e0e-88e6-db81-5a70" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Neural Shredder" id="813f-83cf-f71f-5470" hidden="false" page="117" publicationId="15a4-fc68-502d-48a9" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
