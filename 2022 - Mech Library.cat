        </profile>
      </profiles>
      <rules>
        <rule name="Prehensile Dataspike" id="f3ee-60e7-e8ed-bf54" hidden="false" page="123" publicationId="bde1-6db1-163b-3b76">
          <description>A model equipped with a prehensile dataspike may make an additional single attack per turn as well as any they would normally be eligible to make. These attacks are made using the weapon profiles shown below. Note, a model may not make more than one attack with this weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
