          <rules>
            <rule name="Thanatar Maniple" id="c149-a9f6-4cbe-aa10" hidden="false" page="110" publicationId="bde1-6db1-163b-3b76">
              <description>When deployed onto the battlefield (either at the start of the battle or when arriving from Reserves) all models in the unit must be placed within unit coherency, but afterwards operate independently and are not treated as a single unit.</description>
            </rule>
          </rules>
