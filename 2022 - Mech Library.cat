    <selectionEntry name="Ephemera Nekrotek" id="a40c-3b15-e4df-93a0" hidden="false" import="true" page="152" publicationId="4934-46f7-208b-b4af" type="upgrade">
      <constraints>
        <constraint id="e998-27e9-3fe2-2940" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Viteum Adficio (Cybertheurgic Rite)" id="a70f-9c37-4f02-85a6" hidden="false" import="true" page="152" publicationId="4934-46f7-208b-b4af" type="upgrade">
          <constraints>
            <constraint id="53cc-5ffb-f831-d4c6" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="f8ed-a1d5-789a-6a68" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <rules>
            <rule name="Viteum Adficio (Cybertheurgic Rite)" id="3068-2931-0e2f-19e1" hidden="false" page="152" publicationId="4934-46f7-208b-b4af">
              <description>A Cybertheurgist with this Cybertheurgic Rite may use it at the end of the controlling player&apos;s Movement phase. When they do, the controlling player may select one friendly unit from the Mechanicum Faction that is within 6&quot; of the Cybertheurgist and roll up to three D6. For each result of 4+, one model in that unit suffers a Wound (or loses a Hull Point if it is a Vehicle unit), and the Cybertheurgist regains a lost Wound. Saving Throws and Damage Mitigation rolls cannot be taken against these Wounds.
The Cybertheurgist may choose to make a Cybertheurgy check before using this Cybertheurgic Rite. If successful, the controlling player can re-roll any of the three D6 when using this Cybertheurgic Rite.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Tactus Mors (Cybertheurgic Weapon)" id="e1c0-befd-0e23-787c" hidden="false" import="true" page="152" publicationId="4934-46f7-208b-b4af" type="upgrade">
