    <selectionEntry name="Magisterium Vexilla" id="3ac5-b28c-104a-9de5" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
      <profiles>
        <profile name="Magisterium Vexilla" id="649d-2ad0-6c4a-aaa5" hidden="false" page="156" publicationId="15a4-fc68-502d-48a9" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit that includes at least one model with a Magisterium vexilla may re-roll all failed Leadership tests and may add +1 to the score used to decide if any friendly unit with any models within 12&quot; of any Magisterium vexilla wins a combat in the Assault phase – a friendly unit may only benefit from a single Magisterium vexilla’s bonus in any given combat, regardless of how many are within range.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
