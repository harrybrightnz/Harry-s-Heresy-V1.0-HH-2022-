    <selectionEntry name="Praesidium Shield" id="6f59-3dda-0590-37c7" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
