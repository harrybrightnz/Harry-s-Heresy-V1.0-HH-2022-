    <selectionEntry name="Gyrfalcon Jetbike" id="2652-dd68-cc34-ba03" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
