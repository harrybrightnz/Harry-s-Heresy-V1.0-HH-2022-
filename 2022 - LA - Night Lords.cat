          <rules>
            <rule name="The Bloody Aegis" id="c884-b7be-1496-edd6" hidden="false">
              <description>The Bloody Aegis grants a 4+ Invulnerable Save, increasing to a 3+ Invulnerable Save in close combat. In addition, when fighting in a Challenge, each To Hit roll of a 1 made by the opposing player for attacks directed against Kheron Ophion result in a single S4, AP - wound being inflicted upon the model Engaged in a Challenge with Kheron Ophion.</description>
            </rule>
          </rules>
        </selectionEntry>
