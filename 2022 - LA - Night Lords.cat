                <characteristic name="Save" typeId="e593-6b3c-f169-04f0">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="The Coward" id="c879-0626-2066-ed7e" hidden="false">
              <description>Once Kheron Ophion has lost at least a single wound, he gains the Feel No Pain (4+) special rule. When reduced to a single remaining wound, Kheron Ophion replaces Feel No Pain (4+) with Feel No Pain (3+).</description>
            </rule>
          </rules>
