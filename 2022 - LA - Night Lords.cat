            <profile name="Shadows of Past and Future" id="30d7-cf0b-c69b-9311" hidden="false" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">At the start of any Assult Phase a Psychic check may be made for Sevatar by the controlling player: This Psychic check must be made against a Leadership of 7. If this check is passed, Sevatar gainst +1 WS and Attacks for the Duration of that Assult phase. If the Check is failed, Sevatar suffers Perils of the Warp.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
