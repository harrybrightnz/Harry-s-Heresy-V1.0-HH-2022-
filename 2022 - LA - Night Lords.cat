          </profiles>
          <rules>
            <rule name="Dirty Fighter" id="22cf-ebe1-449e-0cab" hidden="false">
              <description>When engaged in a Challenge with a model whose Weapon Skill is 5 or more, Sevatar gains the Instant Death special rule on all attacks made during that Challenge.</description>
            </rule>
            <rule name="Dark Dreams" id="2181-0c34-3234-ecf6" hidden="false">
              <description>Sevatar gains access to the Shadows of Past and Future Psychic Power only and gains no other Disciplines, Psychic Powers or Psychic Weapons.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Psychic Powers" id="c6cd-fc91-802f-af6e" collective="false" hidden="false" import="true" type="upgrade">
