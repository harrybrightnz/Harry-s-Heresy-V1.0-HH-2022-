          <profiles>
            <profile name="The Armour of Reason" id="1091-812c-b124-2609" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The Armour of Reason provides a 2+ Armour Save and a 4+ Invulnerable Save and, in addition, the first Invulnerable Save failed by Roboute Guilliman in each separate Phase of the battle may be re-rolled.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
