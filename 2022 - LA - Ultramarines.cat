    <selectionEntry name="Peritarch Targeter" id="35c3-a948-99df-5477" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
