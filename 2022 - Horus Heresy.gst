            <constraint id="8522-dd0b-16b8-c50b" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="84a4-7622-803e-28f3" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
