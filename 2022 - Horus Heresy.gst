        <infoLink name="Pinning" id="236d-01ff-54c4-3e1f" hidden="false" targetId="1c96-205c-59a0-3cf2" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Spicula Rocket System" id="4e04-6964-0774-0e3f" hidden="false" page="133" publicationId="a716-c1c4-7b26-8424" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
          <characteristics>
