          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="f5e9-67d8-bc70-3862" field="selections" includeChildSelections="true" scope="roster" shared="true" type="equalTo" value="0"/>
