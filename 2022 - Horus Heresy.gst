          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="7de7-af3b-ba8c-188a" field="selections" includeChildSelections="true" scope="roster" shared="true" type="equalTo" value="0"/>
