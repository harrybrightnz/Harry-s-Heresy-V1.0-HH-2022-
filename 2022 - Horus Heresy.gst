      <rules>
        <rule name="Ignore Ld modifiers on Pinning (The Awakening Fire)" id="df64-3c40-5f1a-a101" hidden="true" page="310" publicationId="817a-6288-e016-7469">
          <description>All models with both the Infantry Unit Type and the Legiones Astartes (Salamanders) in a Detachment using this Rite of War ignore all modifiers to their Leadership when making Pinning tests.</description>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="41b5-73f0-cdc9-1f83" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
        <rule name="Infantry" id="ed36-77cb-5da7-3298" hidden="false" page="195" publicationId="e77a-823a-da94-16b9">
          <description>An Infantry unit may only include or be joined by models of the Infantry or Primarch Unit Type, unless a special rule states otherwise.</description>
          <alias>Infantry</alias>
        </rule>
