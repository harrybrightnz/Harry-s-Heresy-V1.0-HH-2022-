          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="636c-12a8-d65c-7ebe" field="selections" includeChildSelections="true" scope="roster" shared="true" type="equalTo" value="0"/>
                  </conditions>
