        <selectionEntry name="XIX: Raven Guard (SL)" id="5cb4-3c55-d967-cf27" hidden="false" import="true" page="148" publicationId="d882-d2a-5da1-92c4" sortIndex="17" type="upgrade">
          <constraints>
            <constraint id="a5b1-4d65-2ca3-2242" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="MT|RG Scion Of The Shadow Master (Hero)" id="04c2-31fa-27af-e675" hidden="false" targetId="fa15-54f7-d993-9071" type="rule"/>
            <infoLink name="MT|RG Expert Snipers (Major)" id="aa09-66bd-e966-c2ce" hidden="false" targetId="e6d7-e2a2-8016-d49f" type="rule"/>
            <infoLink name="MT|RG Masters Of Obfuscation (Minor)" id="653b-87bb-f533-84b8" hidden="false" targetId="5913-86c8-ea33-43da" type="rule"/>
            <infoLink name="MT|RG Shadowkin (Flaw)" id="9957-99a4-9864-1587" hidden="false" targetId="fe87-b409-e7ed-210d" type="rule"/>
          </infoLinks>
        </selectionEntry>
        <selectionEntry name="XX: Alpha Legion (SL)" id="98a6-7b7c-52e9-6fb9" hidden="false" import="true" page="148" publicationId="d882-d2a-5da1-92c4" sortIndex="18" type="upgrade">
          <constraints>
            <constraint id="cbfb-8b82-51cd-69aa" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="MT|AL Look After Their Own (Flaw)" id="567c-bc0c-2a01-3bc4" hidden="false" targetId="cd97-0c67-3e00-080c" type="rule"/>
            <infoLink name="MT|AL Masters Of Misdirection (Minor)" id="ed5b-39c7-18c1-28fe" hidden="false" targetId="3805-9693-2e77-2cdc" type="rule"/>
            <infoLink name="MT|AL Assassination Tactics (Major)" id="076d-3937-d8f2-6edb" hidden="false" targetId="8bd7-1028-8a58-a828" type="rule"/>
            <infoLink name="MT|AL Master of Subterfuge (Hero)" id="7a2c-dbba-1bf1-3eaf" hidden="false" targetId="3405-3e8f-0ea7-1277" type="rule"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Mutable Tactics Traits (Major)" id="4c42-2619-2e5a-659c" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
      <constraints>
        <constraint id="b847-db29-f569-26db" field="selections" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="263d-8e8c-7632-1cd8" field="selections" scope="parent" shared="true" type="max" value="3"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="I: Dark Angels (MT | Major)" id="2611-606a-d359-1b70" hidden="true" import="true" page="140" publicationId="d882-d2a-5da1-92c4" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="2f9b-630e-b120-7f09" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="80d1-09cd-7916-3524" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|DA Ruthless Bladesmen (Major)" id="6ad2-cfd9-fc21-3bb6" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
              <description>If this unit is the winner in an Assault, each enemy unit that lost suffers an additional -1 penalty to the resulting Morale check.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="III: Emperor&apos;s Children (MT | Major)" id="6459-8ea8-08d4-b7d2" hidden="true" import="true" page="140" publicationId="d882-d2a-5da1-92c4" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="2737-b058-191c-af5f" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="09f0-afd4-aed5-dfcc" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|EC Unparalleled Skill (Major)" id="cc0f-ca91-37c7-6c3e" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
              <description>When making a To Hit roll in the Assault phase for a model in this unit, a result of 4+ is always successful.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IV: Iron Warriors (MT | Major)" id="2db0-1fff-f251-862d" hidden="true" import="true" page="141" publicationId="d882-d2a-5da1-92c4" sortIndex="3" type="upgrade">
          <constraints>
            <constraint id="9b51-02b0-e824-a41f" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="354d-b21e-1c88-f53a" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|IW Ruthless Precision (Major)" id="9fad-cf42-cdb1-469b" hidden="false" page="141" publicationId="d882-d2a-5da1-92c4">
              <description>When making a Shooting Attack, this unit gains a bonus of +1 to all Armour Penetration rolls, and a bonus of +1 to To Wound rolls made against units with the Automata or Dreadnought Unit Types.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="V: White Scars (MT | Major)" id="4af0-98db-27b6-6bc4" hidden="true" import="true" page="141" publicationId="d882-d2a-5da1-92c4" sortIndex="4" type="upgrade">
          <constraints>
            <constraint id="e40e-c1d1-c43f-80ac" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="fcf9-3de6-e2e7-04e6" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|WS Swift Of Action (Major)" id="eb7a-cd23-4dc5-5e50" hidden="false" page="141" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit runs, it gains the Shrouded (5+) special rule until the start of the Active player’s next turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="VI: Space Wolves (MT | Major)" id="034a-f25d-55a0-4aea" hidden="true" import="true" page="142" publicationId="d882-d2a-5da1-92c4" sortIndex="5" type="upgrade">
          <constraints>
            <constraint id="3ef7-6a70-39d7-2a20" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="59b5-8b5d-0fb6-97c7" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|SW Spirit Of Fenris (Major)" id="aba0-3282-7198-1d13" hidden="false" page="142" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit successfully Charges, all models in this unit gain a bonus of +1 To Wound.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="VII: Imperial Fists (MT | Major)" id="b1e1-ecc2-5e7d-d6c2" hidden="true" import="true" page="142" publicationId="d882-d2a-5da1-92c4" sortIndex="6" type="upgrade">
          <constraints>
            <constraint id="c32f-a1e0-91c0-40b9" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4412-9c1b-b870-3e0b" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|IF Devastating Volleys (Major)" id="ee4d-3d15-8235-f0ef" hidden="false" page="142" publicationId="d882-d2a-5da1-92c4">
              <description>The unit gains a bonus of +1 to all To Wound rolls with bolt pistols, combi-bolters and bolters as part of any Shooting Attack (including as part of any Reaction).</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="VIII: Night Lords (MT | Major)" id="c221-efc6-d394-e350" hidden="true" import="true" page="143" publicationId="d882-d2a-5da1-92c4" sortIndex="7" type="upgrade">
          <constraints>
            <constraint id="2010-de51-dfd3-a709" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4122-11fc-c202-14c3" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|NL Murderous Intent (Major)" id="3f3d-bc9c-a706-f664" hidden="false" page="143" publicationId="d882-d2a-5da1-92c4">
              <description>At the start of the Fight sub-phase, if this unit outnumbers the enemy models in that combat, models in this unit gain a bonus of +1 to To Hit rolls until the end of the Phase. Models with the Bulky (X) special rule count as a number of models equal to the value included as part of that special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IX: Blood Angels (MT | Major)" id="26aa-b8f8-9497-e7d1" hidden="true" import="true" page="143" publicationId="d882-d2a-5da1-92c4" sortIndex="8" type="upgrade">
          <constraints>
            <constraint id="ed85-4712-aa3c-e3b4" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="d259-8392-ebda-3e52" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|BA Vengeful Blow (Major)" id="d1c9-055a-9dc1-224e" hidden="false" page="143" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit successfully Charges, or is successfully Charged, all models in this unit gain a bonus of +1 To Wound when making attacks with weapons that do not have the Unwieldy special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="X: Iron Hands (MT | Major)" id="c9b0-88b6-1ade-70a2" hidden="true" import="true" page="144" publicationId="d882-d2a-5da1-92c4" sortIndex="9" type="upgrade">
          <constraints>
            <constraint id="03d6-2fab-daaf-5931" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="ae9d-6362-6a6b-3b3a" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|IH Unleash The Storm (Major)" id="6fc5-5c8b-0841-9ca0" hidden="false" page="144" publicationId="d882-d2a-5da1-92c4">
              <description>Each time a model in this unit makes a Shooting Attack that targets a unit within 12&quot;, it gains a bonus of +1 to all To Wound rolls made during that Shooting Attack.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XII: World Eaters (MT | Major)" id="1b39-8677-de2f-8520" hidden="true" import="true" page="144" publicationId="d882-d2a-5da1-92c4" sortIndex="10" type="upgrade">
          <constraints>
            <constraint id="9073-ae15-5266-aa05" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="31b1-96a6-b50a-0305" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|WE Violent Intent (Major)" id="96de-3a6f-9bd0-fd29" hidden="false" page="144" publicationId="d882-d2a-5da1-92c4">
              <description>When making a Charge roll for this unit, roll one additional D6 and discard one of the results.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XIII: Ultramarines (MT | Major)" id="fb8c-3021-e7c5-f3a5" hidden="true" import="true" page="145" publicationId="d882-d2a-5da1-92c4" sortIndex="11" type="upgrade">
          <constraints>
            <constraint id="091e-e6f8-c5b0-e28c" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="3697-65e5-2eee-495c" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|UM Methodical Fighters (Major)" id="32ec-a5bd-91a5-c5aa" hidden="false" page="145" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit makes a Shooting Attack or declares a Charge, if an enemy unit declares a Reaction, its controlling player must make a Leadership test for that unit before expending a point from their Reaction Allotment. If that test is failed, that unit cannot make a Reaction during this Phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XIV: Death Guard (MT | Major)" id="75d7-1918-8dfc-a526" hidden="true" import="true" page="145" publicationId="d882-d2a-5da1-92c4" sortIndex="12" type="upgrade">
          <constraints>
            <constraint id="1b76-1e5f-4422-e6ba" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="7269-248a-cd22-03fa" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|DG Inexorable Assault (Major)" id="5f32-7a60-9ed3-d524" hidden="false" page="145" publicationId="d882-d2a-5da1-92c4">
              <description>If every model in this unit has not moved more than 7&quot; in the controlling player’s Movement phase, it is counted as Stationary when making Shooting Attacks until the start of the controlling player’s next turn. This does not apply to units with the Vehicle Unit Type or Artillery Unit Sub-type.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XV: Thousand Sons (MT | Major)" id="0df7-81bd-808a-9f56" hidden="true" import="true" page="146" publicationId="d882-d2a-5da1-92c4" sortIndex="13" type="upgrade">
          <constraints>
            <constraint id="51da-6adc-c903-2301" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Psychic Focus" id="daa5-be45-74b8-4178" hidden="false" targetId="bff3-3548-b2b8-72f1" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="ec51-bdcd-862c-3899" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Prosperine Wrath" id="1082-6f0f-2f8c-f9e5" hidden="false" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon">
              <characteristics>
                <characteristic name="Range" typeId="62ec-fbf5-5252-0d17">24&quot;</characteristic>
                <characteristic name="Strength" typeId="17ff-12e7-77d3-2fbe">*</characteristic>
                <characteristic name="AP" typeId="f431-a7b9-d9d0-36c9">3</characteristic>
                <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 1, Rending (6+), Psychic Focus</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="MT|TS Wielders Of The Warp (Major)" id="b224-c37c-33eb-c8ea" hidden="false" page="146" publicationId="d882-d2a-5da1-92c4">
              <description>One non-Vehicle Thousand Sons model in this unit gains the Prosperine Wrath Psychic Weapon, and is treated as having the Psyker Unit Sub-type for the purposes of using it (note that this does not give that model access to any other Psychic Disciplines).
*The Strength Characteristic of this Psychic Weapon is equal to 3 plus the number of Thousand Sons models in this unit, to a maximum of Strength 10.
(BS Note: Psyker Unit type not added on BS as it only applies to 1 model each phase, and only if they are the major component of the unit.)</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XVI: Sons of Horus (MT | Major)" id="173f-9084-c487-eeb8" hidden="true" import="true" page="146" publicationId="d882-d2a-5da1-92c4" sortIndex="14" type="upgrade">
          <constraints>
            <constraint id="d9d5-e723-b00b-ff0c" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="f83b-93b6-9494-e9c7" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|SoH Punishing Volley (Major)" id="ddbb-5a7b-517d-873f" hidden="false" page="146" publicationId="d882-d2a-5da1-92c4">
              <description>Each time a model in this unit makes a Shooting Attack that targets a unit within 12&quot;, it gains a bonus of +1 to all To Hit rolls made during that Shooting Attack</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XVII: Word Bearers (MT | Major)" id="b2c5-1e9a-5955-ab39" hidden="true" import="true" page="147" publicationId="d882-d2a-5da1-92c4" sortIndex="15" type="upgrade">
          <constraints>
            <constraint id="e074-4bd5-c41c-bc43" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="3128-d6dd-15e3-586d" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|WB Zealous Devotion (Major)" id="5511-0371-868b-946f" hidden="false" page="147" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit has successfully Charged, if it is part of a combat that results in a draw, then a side that includes this unit is counted as having won the combat by 1 point. If both sides include models with this special rule then the combat remains a draw.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XVIII: Salamanders (MT | Major)" id="61e0-0593-e4ff-122a" hidden="true" import="true" page="147" publicationId="d882-d2a-5da1-92c4" sortIndex="16" type="upgrade">
          <constraints>
            <constraint id="075f-2427-60e6-0e6c" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="0516-835b-a0d4-e87c" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|SAL Scions Of The Flame (Major)" id="27b4-aa61-fb1e-553f" hidden="false" page="147" publicationId="d882-d2a-5da1-92c4">
              <description>When a model in this unit makes a Shooting Attack, attacks made with weapons with the Flame, Melta, Plasma or Volkite types gain a bonus of +1 To Wound.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XIX: Raven Guard (MT | Major)" id="efc0-bfc4-1544-9ed4" hidden="true" import="true" page="148" publicationId="d882-d2a-5da1-92c4" sortIndex="17" type="upgrade">
          <constraints>
            <constraint id="6bcb-6d82-4157-8f52" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="5cb4-3c55-d967-cf27" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|RG Expert Snipers (Major)" id="e6d7-e2a2-8016-d49f" hidden="false" page="148" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit makes a Shooting Attack (excluding attacks made with Heavy or Ordnance weapons), the controlling player can allocate the first Wound.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XX: Alpha Legion (MT | Major)" id="f2fa-68cd-0c59-2cee" hidden="true" import="true" page="148" publicationId="d882-d2a-5da1-92c4" sortIndex="18" type="upgrade">
          <constraints>
            <constraint id="1b0e-8357-5173-561b" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="98a6-7b7c-52e9-6fb9" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|AL Assassination Tactics (Major)" id="8bd7-1028-8a58-a828" hidden="false" page="148" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit has successfully Charged, Alpha Legion models in this unit have the Precision Strikes (5+) special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Mutable Tactics Traits (Minor/Flaw)" id="319a-43d5-28c0-6d4e" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
      <constraints>
        <constraint id="d322-c689-6a55-a08a" field="selections" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="9d9d-e42a-4395-9990" field="selections" scope="parent" shared="true" type="max" value="3"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="I: Dark Angels (MT | Minor/Flaw)" id="f23f-7549-d4a7-eaa1" hidden="true" import="true" page="140" publicationId="d882-d2a-5da1-92c4" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="e69b-738c-28d1-1f0a" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="80d1-09cd-7916-3524" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|DA Children Of Old Night (Minor)" id="67cc-420b-b06f-1d21" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
              <description>This unit makes all Snap Shots at BS 2 instead of BS 1.</description>
            </rule>
            <rule name="MT|DA Bound By The Hekonystika (Flaw)" id="8adc-b287-3288-08d2" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
              <description>Reduce the Leadership Characteristic of all models in this unit by -1.
(BS Note: Stats not changed on BS)</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="III: Emperor&apos;s Children (MT | Minor/Flaw)" id="14a1-6b82-5950-0431" hidden="true" import="true" page="140" publicationId="d882-d2a-5da1-92c4" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="3f58-f2aa-0592-9911" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="09f0-afd4-aed5-dfcc" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|EC Expert Duellists (Minor)" id="7ca7-45d9-0052-5e6a" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
              <description>Emperor’s Children models in this unit gain the Chosen Warriors special rule.
(BS Note: Stats not changed on BS)</description>
            </rule>
            <rule name="MT|EC Warrior&apos;s Pride (Flaw)" id="892f-9fa9-05e9-71d0" hidden="false" page="140" publicationId="d882-d2a-5da1-92c4">
              <description>If you choose to refuse a Challenge and there was an eligible Emperor’s Children model from this unit that could have accepted, models in this unit suffer a -1 penalty to all To Hit rolls until the end of that turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IV: Iron Warriors (MT | Minor/Flaw)" id="7bd8-caf0-a666-9ec7" hidden="true" import="true" page="141" publicationId="d882-d2a-5da1-92c4" sortIndex="3" type="upgrade">
          <constraints>
            <constraint id="d0e5-c1bf-fddb-c6c6" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="354d-b21e-1c88-f53a" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|IW Accustomed To Devastation (Minor)" id="a1b0-63a9-738c-677c" hidden="false" page="141" publicationId="d882-d2a-5da1-92c4">
              <description>Models in this unit are considered to have a Leadership Characteristic of 10 when resolving Morale checks in the Shooting phase.</description>
            </rule>
            <rule name="MT|IW Uncontrolled Volleys (Flaw)" id="c539-41a3-2791-bb32" hidden="false" page="141" publicationId="d882-d2a-5da1-92c4">
              <description>When making a Shooting Attack as part of a Reaction, weapons used for that Shooting Attack by Iron Warriors models in this unit have the Gets Hot special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="V: White Scars (MT | Minor/Flaw)" id="8160-4e10-1086-6ace" hidden="true" import="true" page="141" publicationId="d882-d2a-5da1-92c4" sortIndex="4" type="upgrade">
          <constraints>
            <constraint id="fbc2-3335-d462-7ec2" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="fcf9-3de6-e2e7-04e6" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|WS Fleet-Footed (Minor)" id="d787-6f8a-c0b8-3960" hidden="false" page="141" publicationId="d882-d2a-5da1-92c4">
              <description>When Running, making Sweeping Advances or moving as part of a Reaction, all models in this unit count their Initiative as 6.</description>
            </rule>
            <rule name="MT|WS Restless Temperament (Flaw)" id="f99c-0fb4-5a61-a761" hidden="false" page="141" publicationId="d882-d2a-5da1-92c4">
              <description>If every model in this unit does not end the Movement phase at least 4&quot; from where it began that Phase, each model in that unit suffers a -1 penalty to its Leadership Characteristic until the start of the Active player’s next turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="VI: Space Wolves (MT | Minor/Flaw)" id="2044-e799-3a0f-a59a" hidden="true" import="true" page="142" publicationId="d882-d2a-5da1-92c4" sortIndex="5" type="upgrade">
          <constraints>
            <constraint id="ce4b-4d62-58b9-0b66" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="59b5-8b5d-0fb6-97c7" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|SW One Hand On Their Blade (Minor)" id="c7a1-bdf0-3780-309a" hidden="false" page="142" publicationId="d882-d2a-5da1-92c4">
              <description>Models in this unit can still fire bolters or bolt pistols in a turn in which they have Run. If they do so, they must fire Snap Shots.</description>
            </rule>
            <rule name="MT|SW Undisciplined Assault (Flaw)" id="9427-ee37-d9f0-5647" hidden="false" page="142" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit is selected to make a Charge, the controlling player must make a Leadership test for it. If that test is failed, that Charge is Disordered.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="VII: Imperial Fists (MT | Minor/Flaw)" id="c982-169b-7ea2-c217" hidden="true" import="true" page="142" publicationId="d882-d2a-5da1-92c4" sortIndex="6" type="upgrade">
          <constraints>
            <constraint id="685d-9e6c-c218-2187" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4412-9c1b-b870-3e0b" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|IF Defensive Instincts (Minor)" id="52c6-5262-e5d1-3381" hidden="false" page="142" publicationId="d882-d2a-5da1-92c4">
              <description>Improve the cover save models in this unit have by 1 (e.g., a model in this unit who has a 5+ Cover Save instead has a 4+ Cover Save). This does not grant a Cover Save to a model that is not eligible for one.</description>
            </rule>
            <rule name="MT|IF Surety Of Action (Flaw)" id="50ab-0fd7-5f00-6876" hidden="false" page="142" publicationId="d882-d2a-5da1-92c4">
              <description>If the controlling player has any of their Reaction Allotment remaining, this unit must make a Reaction if eligible to do so.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="VIII: Night Lords (MT | Minor/Flaw)" id="8a17-6b6b-4f2d-7439" hidden="true" import="true" page="143" publicationId="d882-d2a-5da1-92c4" sortIndex="7" type="upgrade">
          <constraints>
            <constraint id="39ef-46c3-9533-5cd6" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4122-11fc-c202-14c3" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|NL Trophy Takers (Minor)" id="60fd-0ae8-3077-986d" hidden="false" page="143" publicationId="d882-d2a-5da1-92c4">
              <description>When making a Sweeping Advance with this unit, you can roll an additional D6 and discard one of them.</description>
            </rule>
            <rule name="MT|NL Wary Of A Fair Fight (Flaw)" id="81ba-8aae-c95f-a998" hidden="false" page="143" publicationId="d882-d2a-5da1-92c4">
              <description>This unit may not declare a Charge unless it outnumbers the target unit. Models with the Bulky (X) special rule count as a number of models equal to the value included as part of that special rule. In addition, if this unit is the closer in an Assault, it suffers an additional -1 penalty to the resulting Morale check.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="IX: Blood Angels (MT | Minor/Flaw)" id="a4c8-4d0a-abab-0709" hidden="true" import="true" page="143" publicationId="d882-d2a-5da1-92c4" sortIndex="8" type="upgrade">
          <constraints>
            <constraint id="82e0-60f5-917e-7d47" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="d259-8392-ebda-3e52" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|BA Encarmine Guile (Minor)" id="9c53-21ab-e630-d697" hidden="false" page="143" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit successfully Charged, Blood Angels models in this unit gain the Hammer of Wrath (1) special rule.</description>
            </rule>
            <rule name="MT|BA Furious Bloodlust (Flaw)" id="7b34-f6c7-261e-d260" hidden="false" page="143" publicationId="d882-d2a-5da1-92c4">
              <description>This unit must declare a Charge in any of the controlling player’s Assault phases if it is eligible to do so and there is at least one model from any enemy unit within 12&quot; and line of sight of it.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="X: Iron Hands (MT | Minor/Flaw)" id="2f1f-a953-2f24-0998" hidden="true" import="true" page="144" publicationId="d882-d2a-5da1-92c4" sortIndex="9" type="upgrade">
          <constraints>
            <constraint id="1649-b913-e74a-ad17" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="ae9d-6362-6a6b-3b3a" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|IH Iron Resolve (Minor)" id="f8a5-20c5-acd7-601a" hidden="false" page="144" publicationId="d882-d2a-5da1-92c4">
              <description>Each time a Shooting Attack is allocated to an Iron Hands model in this unit, that model gains the Feel No Pain (5+) special rule against that attack.</description>
            </rule>
            <rule name="MT|IH Overly Cautous (Flaw)" id="4c94-cbc9-79a7-2ab5" hidden="false" page="144" publicationId="d882-d2a-5da1-92c4">
              <description>This unit may not Run or make Sweeping Advances</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XII: World Eaters (MT | Minor/Flaw)" id="e218-edc9-d8c9-dbff" hidden="true" import="true" page="144" publicationId="d882-d2a-5da1-92c4" sortIndex="10" type="upgrade">
          <constraints>
            <constraint id="8ae0-884f-0cad-f0f3" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="31b1-96a6-b50a-0305" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|WE Raging Slayers (Minor)" id="9735-2b30-3683-ba7b" hidden="false" page="144" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit successfully Charges, the first failed Armour Saving throw for this unit in that Fight sub-phase is ignored (this has no effect if the weapon’s Armour Piercing value is equal to or lower than the model’s Armour Save).</description>
            </rule>
            <rule name="MT|WE Berserker Frustration (Flaw)" id="57c2-d0c9-1e94-f452" hidden="false" page="144" publicationId="d882-d2a-5da1-92c4">
              <description>If this unit is within 12&quot; of an enemy unit and a Charge is not declared for it during the controlling player’s Assault phase, the controlling player must make a Pinning test for this unit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XIII: Ultramarines (MT | Minor/Flaw)" id="f153-c2b4-59d3-e118" hidden="true" import="true" page="145" publicationId="d882-d2a-5da1-92c4" sortIndex="11" type="upgrade">
          <constraints>
            <constraint id="84bf-37f6-ea47-aaf4" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="3697-65e5-2eee-495c" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|UM Prepared Attack (Minor)" id="040a-1869-b523-dabb" hidden="false" page="145" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit makes a Shooting Attack as part of a Reaction, add +1 to To Hit rolls for that Shooting Attack.</description>
            </rule>
            <rule name="MT|UM Strict Chain Of Command (Flaw)" id="839b-c3bb-7da5-44aa" hidden="false" page="145" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit is selected to make a Reaction, make a Leadership test for this unit before expending a point from your Reaction Allotment. If this Test is failed, that unit cannot make a Reaction during this Phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XIV: Death Guard (MT | Minor/Flaw)" id="9fbb-e5ec-4857-2a9d" hidden="true" import="true" page="145" publicationId="d882-d2a-5da1-92c4" sortIndex="12" type="upgrade">
          <constraints>
            <constraint id="9153-0a70-fff6-3091" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="7269-248a-cd22-03fa" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|DG Children Of Barbarus (Minor)" id="987b-0ad3-d2b9-e4dc" hidden="false" page="145" publicationId="d882-d2a-5da1-92c4">
              <description>Non-Vehicle models in this unit gain a 3+ Invulnerable Save against Wounds suffered as a result of Dangerous Terrain tests.</description>
            </rule>
            <rule name="MT|DG Unhurried Death (Flaw)" id="e088-c140-173e-fb25" hidden="false" page="145" publicationId="d882-d2a-5da1-92c4">
              <description>When this unit Runs, makes a Sweeping Advance or moves as part of a Reaction, models in this unit are treated as having an Initiative Characteristic of 2.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XV: Thousand Sons (MT | Minor/Flaw)" id="693e-669f-1496-429b" hidden="true" import="true" page="146" publicationId="d882-d2a-5da1-92c4" sortIndex="13" type="upgrade">
          <constraints>
            <constraint id="a389-a825-24f9-bb68" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="ec51-bdcd-862c-3899" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|TS Conjured Illusions (Minor)" id="4566-2051-ae79-9d3a" hidden="false" page="146" publicationId="d882-d2a-5da1-92c4">
              <description>If this unit Falls Back from combat, models in this unit are treated as having an Initiative Characteristic of 6 for the purposes of Sweeping Advances.</description>
            </rule>
            <rule name="MT|TS Undisciplined Mystics (Flaw)" id="027e-d662-96ef-5b2b" hidden="false" page="146" publicationId="d882-d2a-5da1-92c4">
              <description>Whenever a result of 11 or 12 is rolled for a Morale check or Pinning test for this unit, this unit suffers Perils of the Warp.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XVI: Sons of Horus (MT | Minor/Flaw)" id="fe36-6bda-fb4c-d693" hidden="true" import="true" page="146" publicationId="d882-d2a-5da1-92c4" sortIndex="14" type="upgrade">
          <constraints>
            <constraint id="e717-d0de-a06b-7e39" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="f83b-93b6-9494-e9c7" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|SoH Legacy Of Brutality (Minor)" id="d06f-6e45-cbd9-61c0" hidden="false" page="146" publicationId="d882-d2a-5da1-92c4">
              <description>At the start of the Fight sub-phase, if this unit is outnumbered by enemy models in that combat, models in this unit gain a bonus of +1 to To Hit rolls until the end of the phase. Models with the Bulky (X) special rule count as a number of models equal to the value included as part of that special rule.</description>
            </rule>
            <rule name="MT|SoH Towering Arrogance (Flaw)" id="7a33-4d44-f9c0-7d01" hidden="false" page="146" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit is eligible to declare a Reaction to a Shooting Attack or Charge declared by an enemy unit if this unit outnumbers that enemy unit, this unit is not eligible to make a Reaction. Models with the Bulky (X) special rule count as a number of models equal to the value included as part of that special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XVII: Word Bearers (MT | Minor/Flaw)" id="06a7-4d59-98f3-9fbb" hidden="true" import="true" page="147" publicationId="d882-d2a-5da1-92c4" sortIndex="15" type="upgrade">
          <constraints>
            <constraint id="f8ba-239f-e303-8b5a" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="3128-d6dd-15e3-586d" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|WB Righteous Determination (Minor)" id="d52c-7a62-2b9f-d4ff" hidden="false" page="147" publicationId="d882-d2a-5da1-92c4">
              <description>When making a Morale check or Pinning test for this unit, roll one additional D6 and discard one before determining the result.</description>
            </rule>
            <rule name="MT|WB Eternal Penitents (Flaw)" id="fc8d-7e67-8abb-d717" hidden="false" page="147" publicationId="d882-d2a-5da1-92c4">
              <description>When this unit fails a Leadership test, Morale check or Pinning test, it suffers one automatic Wound with no saves or Damage Mitigation rolls of any kind allowed.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XVIII: Salamanders (MT | Minor/Flaw)" id="3063-a59a-ed33-02b8" hidden="true" import="true" page="147" publicationId="d882-d2a-5da1-92c4" sortIndex="16" type="upgrade">
          <constraints>
            <constraint id="d407-f674-0e55-7683" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="0516-835b-a0d4-e87c" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|SAL Steadfast Bulwark (Minor)" id="2636-f334-c602-ed42" hidden="false" page="147" publicationId="d882-d2a-5da1-92c4">
              <description>During a turn in which this unit is successfully Charged, all models in this unit gain the Feel No Pain (5+) special rule until the end of the turn.</description>
            </rule>
            <rule name="MT|SAL Prudent Fighters (Flaw)" id="69f2-175f-c745-8f31" hidden="false" page="147" publicationId="d882-d2a-5da1-92c4">
              <description>This unit may not declare Shooting Attacks or Charges that target units that are Falling Back and may not make Sweeping Advances.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XIX: Raven Guard (MT | Minor/Flaw)" id="dfea-1145-fc23-2889" hidden="true" import="true" page="148" publicationId="d882-d2a-5da1-92c4" sortIndex="17" type="upgrade">
          <constraints>
            <constraint id="c551-c707-9df2-f714" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="5cb4-3c55-d967-cf27" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|RG Masters Of Obfuscation (Minor)" id="5913-86c8-ea33-43da" hidden="false" page="148" publicationId="d882-d2a-5da1-92c4">
              <description>Each time an enemy unit makes a Shooting Attack that targets this unit, if the closest model in this unit is more than 18&quot; away, all models in this unit have the Shrouded (6+) special rule against that Shooting Attack.</description>
            </rule>
            <rule name="MT|RG Shadowkin (Flaw)" id="fe87-b409-e7ed-210d" hidden="false" page="148" publicationId="d882-d2a-5da1-92c4">
              <description>Each time this unit makes a Morale check, if it is not wholly within a zone of Area Terrain, subtract -1 from the Leadership Characteristic of models in this unit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="XX: Alpha Legion (MT | Minor/Flaw)" id="4428-5e7a-caec-9108" hidden="true" import="true" page="148" publicationId="d882-d2a-5da1-92c4" sortIndex="18" type="upgrade">
          <constraints>
            <constraint id="83cb-b70d-ffde-8c9f" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="98a6-7b7c-52e9-6fb9" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="MT|AL Masters Of Misdirection (Minor)" id="3805-9693-2e77-2cdc" hidden="false" page="148" publicationId="d882-d2a-5da1-92c4">
              <description>If an enemy unit makes a Shooting Attack that targets this unit, and there is another eligible target unit that is closer to the enemy unit making the Shooting Attack, models in this unit gain the Shrouded (6+) special rule for the duration of that Shooting Attack.</description>
            </rule>
            <rule name="MT|AL Look After Their Own (Flaw)" id="cd97-0c67-3e00-080c" hidden="false" page="148" publicationId="d882-d2a-5da1-92c4">
              <description>When allocating Wounds to models in this unit, the controlling player must allocate Wounds to a non-Alpha Legion model if possible.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
