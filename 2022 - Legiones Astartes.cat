      <rules>
        <rule name="Fury of Olympia" id="7fa2-fe3e-d241-4590" hidden="true" page="178" publicationId="09c5-eeae-f398-b653">
          <description>A model with this special rule may add one to the number of shots fired when making a Shooting Attack with a shrapnel bolter or shrapnel pistol (but not with shrapnel cannon or Gravis shrapnel cannon or any other ‘Bolt’ weapon).</description>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1d51-72ff-c102-09d3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Legion Tactical Sergeant" id="638c-a192-24e6-1604" collective="false" hidden="false" import="true" type="model">
          <categoryLinks>
            <categoryLink name="Character" id="35cb-31a0-80f5-3eb1" hidden="false" primary="false" targetId="f75a-d5c1-59ba-5c5a"/>
            <categoryLink name="Infantry Unit Type" id="b173-ab33-4e08-a093" primary="false" targetId="8b4f-bfe2-ce7b-f1b1"/>
