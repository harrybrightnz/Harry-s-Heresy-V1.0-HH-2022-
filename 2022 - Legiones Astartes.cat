                    <condition childId="b2b4-2198-0b90-dd9f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry name="Augurs of Weakness" id="11d9-333f-95f4-0adf" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Augurs of Weakness" id="0638-e26a-2bbb-628f" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">When making an Armor Penetration roll against a target with Armour 11 or more on the facing targeted, a model with this special rule may add +1 to the Strength of the weapon used in the attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Icons of Resolve" id="c891-3932-b6f5-5d66" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Icons of Resolve" id="f304-068a-faab-17e4" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model gains +1 Leadership (to a maximum of 10) on any turn in which it, or a unit it is part of, is Charged by one or more enemy units.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Slayers of Kings" id="1d55-8faa-84f9-7aa6" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Slayers of Kings" id="619b-7765-d39a-775d" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll failed To Hit rolls of &apos;1&apos; when Engaged in combat with any model with a Weapon Skill of 5 or higher or in a Challenge with any model with a Weapon Skill of 5 or higher.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Hunter of Beasts" id="bb1c-0134-a0ff-a758" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Hunter of Beasts" id="6c5e-e7fd-c4eb-d0f1" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll failed To Wound rolls of &apos;1&apos; when any enemy unit it is Engaged in combat with includes one or more models with a Toughness of 5, or any failed To Wound roll if the target&apos;s Toughness is 6 or higher.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Reaper of Hosts" id="37ec-330f-d525-24d4" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Reaper of Hosts" id="478a-68bb-f32c-b29b" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model gains +1 Attack in any Fight sub-phase which they begin in base contact with more than one enemy model.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Breaker of Witches" id="0389-eebf-42ac-b9b6" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Breaker of Witches" id="0163-a212-d07e-34aa" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll all To Hit and To Wound rolls in close combat when attacking an enemy unit that includes one or more models with the Daemon Unit Type or the Psyker or Corrupted Sub-type.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
