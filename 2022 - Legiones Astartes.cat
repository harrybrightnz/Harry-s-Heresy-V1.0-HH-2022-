          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="c0df-c1fa-5ddc-9ee5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                    <condition childId="b5b7-3410-a8e5-95a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="ae4a-f95c-968e-eb46" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="25a2-7a52-632a-6b2c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="False Colours" id="3254-6e1d-b3bc-b618" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">A unit composed entirely of models with this special rule may not be targeted with a Shooting Attack by an enemy unit as long as the unit with this special rule has not made a Shooting Attack at any point in the battle. Once a unit or model with this special rule has made a Shooting Attack or successfully Charged an enemy unit (including during a Reaction) then this special rule has no further effect, nor does this special rule restrict the enemy from declaring Charges targeting a model or unit that has this special rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Centurion" id="d3d6-dfc2-4da2-54cc" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry name="Overseer" id="e9f2-f58a-6df3-5fdc" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6381-09dc-1c8d-3ac6" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5e23-3342-0a92-0b9a" field="selections" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="25"/>
          </costs>
          <infoLinks>
            <infoLink name="Support Squad" id="79bc-8ea0-0b47-f23e" hidden="true" targetId="768e-56d6-ca52-24ae" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="25a2-7a52-632a-6b2c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Master of Auxilia" id="3b38-21a6-9d01-ea05" hidden="false" page="177" publicationId="d882-d2a-5da1-92c4">
              <description>Master of Auxilia: A model with this special rule must join a Solar Auxilia Rifle Section or Imperialis Militia Infantry Squad, chosen by the controlling player that was selected as an Overseer’s Retinue during deployment and once joined, may not voluntarily leave the unit during the course of any battle and may only join units selected through the use of the Overseer’s Retinue special rule. Whilst part of a unit selected as an Overseer’s Retinue, Wounds may not be allocated to the model with the Master of Auxilia special rule by the controlling player unless there are no other valid models in the targeted Overseer’s Retinue unit to allocate Wounds to. Additionally, a model with the Master of Auxilia special rule is considered to have the same variant of the Legiones Auxilia (X) special rule as the models in the unit that they have joined.</description>
            </rule>
            <rule name="Overseer’s Retinue" id="28ce-a016-b508-8823" hidden="false" page="177" publicationId="d882-d2a-5da1-92c4">
              <description>Overseer’s Retinue: An army that includes a model with this special rule may take a Tercio of 1-3 Solar Auxilia Rifle Sections or 1-3 Imperialis Militia Infantry Squads in accordance with the Strength in Numbers special rule*, as part of the same Force Organisation choice as the model with this special rule, as an Overseer’s Retinue. Note that any unit selected through the use of this special rule may not take any Dedicated Transport options.
Any Solar Auxilia Rifles Sections included through the use of the Overseer’s Retinue gain the Legiones Auxilia (X) special rule that corresponds with the Legiones Astartes (X) special rule that the Legion Overseer they share a Force Organisation choice with has. Additionally, all models in a Tercio selected as an Overseer’s Retinue use the Leadership Characteristic of the model with the Legiones Overseer special rule when ‘In Formation’.
* Note that rules for these units are found in the Warhammer: The Horus Heresy – Liber Imperium book or the Legacies of the Age of Darkness: the Imperialis Militia army list.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
