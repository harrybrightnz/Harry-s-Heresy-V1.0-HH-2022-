      <profiles>
        <profile name="Warp Scream" id="5b54-1184-8e27-26ca" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a warp scream gains the Hammer of Wrath (1) special rule. If the model already has the Hammer of Wrath (X) special rule, add 1 to the value of that Hammer of Wrath (X) special rule instead. Hammer of Wrath attacks made by a model with a warp scream have the Rending (5+) special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
