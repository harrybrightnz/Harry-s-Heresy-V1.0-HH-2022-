        <selectionEntry name="Castellan" id="7962-e835-2ae5-c6f1" collective="false" hidden="true" import="true" page="229" publicationId="817a-6288-e016-7469" type="upgrade">
          <categoryLinks>
            <categoryLink name="Legion Consularis:" id="72d5-75cf-a419-9d6b" hidden="false" primary="false" targetId="4171-e276-e90d-b8e5"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="b5b7-3410-a8e5-95a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="a0e1-f2c4-8bcd-0723" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                    <condition childId="25a2-7a52-632a-6b2c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="ae4a-f95c-968e-eb46" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Fire Support" id="5bb6-5abe-e59c-ac78" hidden="false" typeId="b46c-270c-d29e-f0ff" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">When making an attack with a Heavy weapon, a Castellan may increase the number of attacks made with that weapon by +1 when making a Shooting Attack (for example, a Castellan making a Shooting Attack with a Heavy 3 weapon would roll an additional dice for its attacks, rolling four dice in total). In addition, any Legion Heavy Support Squads in the same Detachment as a Castellan gain the Line Sub-type.</characteristic>
              </characteristics>
            </profile>
