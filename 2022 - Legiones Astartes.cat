                    <selectionEntry name="Company Standard" id="ec50-a185-29a4-ba7a" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="0ce5-f120-ff33-2a1a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/>
                      </costs>
                      <profiles>
                        <profile name="Company Standard" id="3d2e-1a99-0e61-47c1" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
                          <characteristics>
                            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">All of the controlling player’s units with the same variant of the Legiones Astartes (X) special rule within 6&quot; of a friendly model with a company standard are considered to have a Leadership Characteristic of 9 when resolving Morale checks or Pinning tests (but not Psychic checks). In addition, all models in a unit that includes a company standard gain the Line Sub-type as long as they remain part of that unit – this benefit is lost immediately if the model with the company standard is removed as a casualty.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntry>
