          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">This grants the model the Night Vision special rule and a bonus of +1 to their Ballistic Skill Characteristic. However, the model, and any unit they have joined, counts as having an Initiative of 1 when taking Blind tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
