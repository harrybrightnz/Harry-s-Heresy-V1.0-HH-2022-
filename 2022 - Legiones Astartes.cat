    <selectionEntry name="Warhawk Jump Pack" id="a298-8584-70ed-18ce" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Deep Strike:" id="7add-da6c-6a6b-9b96" hidden="false" primary="false" targetId="0d4f-ff28-d819-a512"/>
        <categoryLink name="Jump Infantry:" id="22e2-82e2-8469-a0c8" hidden="false" primary="false" targetId="eee8-3c7c-2762-e33e"/>
      </categoryLinks>
      <constraints>
        <constraint id="40c5-9bc1-c15b-1d43" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="-1"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
      <infoLinks>
