          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="cf47-4aef-a6db-782d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                <condition childId="bfc9-c99c-bf8a-3917" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
