        <infoLink name="Feel No Pain (X)" id="ecbf-faf3-7146-a8c4" hidden="false" targetId="ec46-ff29-32e0-c2aa" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Feel No Pain (6+) (Guided by Prophecy)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Guided by Prophecy" id="a13d-c22b-8db1-386d" hidden="false">
          <description>At the start of any Assault phase, a Leadership test may be made for this unit by the controlling player against a Leadership of 7. If this test is passed, models in this unit gain the Feel No Pain (6+) special rule and improve their Weapon Skill characteristic to ‘5’ for the duration of that Assault phase.</description>
        </rule>
      </rules>
