    <selectionEntry name="Arcus Missile Launcher" id="0460-524d-d071-4039" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
      <selectionEntries>
        <selectionEntry name="Arcus Missile Launcher - Arcus Warheads" id="bf68-bcaf-545c-bf93" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a4c5-3d0a-5263-a737" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Twin-linked" id="3b14-f839-164e-b85c" hidden="false" targetId="8542-ee9d-e2fa-52fe" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Arcus Missile Launcher - Arcus Warheads" id="7794-b3cf-39cd-396d" hidden="false" page="133" publicationId="a716-c1c4-7b26-8424" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="95ba-cda7-b831-6066">36&quot;</characteristic>
                <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">8</characteristic>
                <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">2</characteristic>
                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 5, Twin-linked</characteristic>
