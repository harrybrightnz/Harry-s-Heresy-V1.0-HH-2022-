      <profiles>
        <profile name="Ætheric Conduit" id="2b1b-4287-bc6d-6e39" hidden="false" page="23" publicationId="8775-88f5-cfdd-24f6" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with this upgrade gains the Psyker Sub-type and may select a single Core Psychic Discipline from the following list: Biomancy, Diabolism, Pyromancy, Telepathy.</characteristic>
          </characteristics>
        </profile>
      </profiles>
