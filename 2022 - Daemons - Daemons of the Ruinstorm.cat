          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit that contains at least one model with this upgrade gains the Rage (2) special rule, unless a model would already have a higher value of Rage (X).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
