    <selectionEntry name="The Unmaking" id="eb14-1d7a-62f3-60ac" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="41dd-a47d-b6a3-2bf6" field="selections" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Armourbane (X)" id="31cb-efb8-bc17-f64f" hidden="false" targetId="cb59-f920-f071-7cd4" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Armourbane (Ranged)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="The Unmaking" id="2b6f-3284-b50c-5a65" hidden="false" page="23" publicationId="8775-88f5-cfdd-24f6" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="95ba-cda7-b831-6066">12&quot;</characteristic>
