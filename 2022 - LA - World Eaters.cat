      <selectionEntryGroups>
        <selectionEntryGroup name="XII: World Eaters" id="eca2-cd74-4ad6-297e" collective="false" hidden="true" import="true" page="216" publicationId="09c5-eeae-f398-b653">
          <constraints>
            <constraint id="7d30-6c73-d302-3253" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
