  <sharedRules>
    <rule name="Militia Cavalry Mount" id="ac7b-72f5-82f9-23d6" hidden="false" page="37" publicationId="48c2-d023-0069-001a">
      <description>A model with a Militia cavalry mount that chooses to Run gains the Shrouded (5+) special rule until the start of the controlling player’s next turn.


A model with the Infantry Unit Type that selects a Militia cavalry mount as an upgrade must change its Unit Type to Cavalry, keeping any Unit Sub-types it previously had.</description>
    </rule>
    <rule name="Provenance" id="e626-c3b1-e724-c6fc" hidden="false">
      <description>Provenance</description>
    </rule>
    <rule name="Emplaced" id="976f-9e14-413c-5bea" hidden="false" page="24" publicationId="48c2-d023-0069-001a">
      <description>A unit that includes any models with this special rule may only make the Return Fire or Overwatch Core Reactions or the Interceptor Advanced Reaction – no other Reaction of any kind may be made. Additionally, if forced to Fall Back for any reason, all models in the unit are immediately removed as casualties.</description>
    </rule>
  </sharedRules>
