        <infoLink name="Legiones Astartes (Imperial Fists)" id="1258-3152-ad78-96bb" hidden="false" targetId="e876-4f8f-a30f-8b22" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Defiant to the End" id="9770-d552-4dc3-dcdf" hidden="false" page="163" publicationId="4934-46f7-208b-b4af">
          <description>While Camba Diaz only has one Wound remaining, he gains the Feel No Pain (4+) special rule</description>
        </rule>
