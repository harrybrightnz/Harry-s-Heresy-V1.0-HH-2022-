            <selectionEntry name="The Bane of Tyrants (Loyalist only)" id="2a9f-3d0a-7ee5-7fb8" collective="false" hidden="false" import="true" page="328" publicationId="817a-6288-e016-7469" type="upgrade">
              <constraints>
                <constraint id="129f-8410-72a2-5b03" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="02d2-c235-ad13-7e0b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
