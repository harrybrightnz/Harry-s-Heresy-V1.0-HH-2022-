                    <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">2</characteristic>
                    <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Melee, Shred, Blind, Fighting Style, Two-handed</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Fighting Style" id="0504-ce14-8f28-9d3a" hidden="false" page="333" publicationId="817a-6288-e016-7469">
                  <description>At the beginning of each Assault phase, Corvus Corax’s controlling player may choose one of the following special rules to apply to his attacks, based upon the weapons and fighting style he is employing: Murderous Strike (4+), Rage (4) or Sudden Strike (3).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="The Sable Armour" id="e38c-dc86-fae8-eeaa" collective="false" hidden="false" import="true" type="upgrade">
