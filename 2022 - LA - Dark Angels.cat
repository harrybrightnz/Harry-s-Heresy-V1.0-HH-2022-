        <selectionEntryGroup name="I: Dark Angels" id="5ced-784f-824e-986b" collective="false" hidden="true" import="true" page="152" publicationId="817a-6288-e016-7469">
          <constraints>
            <constraint id="43df-248c-010c-c19f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
