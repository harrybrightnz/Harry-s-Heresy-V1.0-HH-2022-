        <selectionEntryGroup name="1) Orders of the Hekatonystika" id="a688-9767-c513-b766" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469">
          <constraints>
            <constraint id="78bf-14d5-2721-6154" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="cca3-cf6e-0b28-e411" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false"/>
          </modifiers>
          <selectionEntries>
            <selectionEntry name="Augurs of Weakness" id="7b03-a316-ebfc-f197" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <rules>
                <rule name="Augurs of Weakness" id="a1dc-0a37-c646-f6af" hidden="false" page="161" publicationId="817a-6288-e016-7469">
                  <description>When making an Armor Penetration roll against a target with Armour 11 or more on the facing targeted, a model with this special rule may add +1 to the Strength of the weapon used in the attack.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Icons of Resolve" id="ea47-e0d2-e3ed-e35a" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <rules>
                <rule name="Icons of Resolve" id="0dee-e39b-8252-1b01" hidden="false" page="161" publicationId="817a-6288-e016-7469">
                  <description>This model gains +1 Leadership (to a maximum of 10) on any turn in which it, or a unit it is part of, is Charged by one or more enemy units.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Slayers of Kings" id="c79d-c85d-fc09-195f" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <rules>
                <rule name="Slayers of Kings" id="c9b1-e3ce-0a55-a54d" hidden="false" page="161" publicationId="817a-6288-e016-7469">
                  <description>This model may re-roll failed To Hit rolls of &apos;1&apos; when Engaged in combat with any model with a Weapon Skill of 5 or higher or in a Challenge with any model with a Weapon Skill of 5 or higher.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Hunter of Beasts" id="6c3a-bc38-62a2-fb14" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <rules>
                <rule name="Hunter of Beasts" id="9db7-54d9-ad3c-bbae" hidden="false" page="161" publicationId="817a-6288-e016-7469">
                  <description>This model may re-roll failed To Wound rolls of &apos;1&apos; when any enemy unit it is Engaged in combat with includes one or more models with a Toughness of 5, or any failed To Wound roll if the target&apos;s Toughness is 6 or higher.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Reaper of Hosts" id="baf2-ace7-dc1f-e914" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <rules>
                <rule name="Reaper of Hosts" id="6eab-f409-d007-001e" hidden="false" page="161" publicationId="817a-6288-e016-7469">
                  <description>This model gains +1 Attack in any Fight sub-phase which they begin in base contact with more than one enemy model.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Breaker of Witches" id="9eed-7e1c-0e7b-c249" collective="false" hidden="false" import="true" page="161" publicationId="817a-6288-e016-7469" type="upgrade">
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
              <rules>
                <rule name="Breaker of Witches" id="e5f2-0657-e1da-5be1" hidden="false" page="161" publicationId="817a-6288-e016-7469">
                  <description>This model may re-roll all To Hit and To Wound rolls in close combat when attacking an enemy unit that includes one or more models with the Daemon Unit Type or the Psyker or Corrupted Sub-type.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
