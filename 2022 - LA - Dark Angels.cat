                    <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">+2</characteristic>
                    <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">3</characteristic>
                    <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Melee, Two-handed, Shred, Breaching (4+), Reaping Blow (2), Master-crafted, Fearsome Ruin</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Fearsome Ruin" id="1d7b-d4fd-ae65-eca7" hidden="false">
                  <description>The controlling player of any unit which suffers one or more casualties from this weapon and makes a Morale check during the Assault phase must roll an additional D6 for that Check and keep the two highest dice to determine the result of that Morale check.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Marduk Sedras" id="9136-b5e8-13f9-0c0f" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
