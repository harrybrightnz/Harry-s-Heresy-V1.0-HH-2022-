            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="554b-1024-a345-0d14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
