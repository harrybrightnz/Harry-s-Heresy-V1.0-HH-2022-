<catalogue name="Daemon Library" id="31bf-eb23-33a-3d65" authorName="a" battleScribeVersion="2.03" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="77" library="true" revision="8" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
