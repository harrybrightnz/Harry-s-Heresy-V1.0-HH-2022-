      <selectionEntryGroups>
        <selectionEntryGroup name="XIV: Death Guard" id="9207-442b-b932-4e2f" collective="false" hidden="true" import="true" page="234" publicationId="09c5-eeae-f398-b653">
          <constraints>
            <constraint id="57b4-dc58-2717-a7ee" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
