              </characteristics>
              <modifiers>
                <modifier field="e8a6-1da9-d384-8727" type="increment" value="1">
                  <conditions>
                    <condition childId="fe04-c096-f846-a6fd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
