        <selectionEntry name="Lifeward Section" id="2a87-dbc1-ad18-9949" hidden="false" import="true" page="186" publicationId="d882-d2a-5da1-92c4" type="unit">
          <constraints>
            <constraint id="5fbd-9f4-8099-5f83" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
