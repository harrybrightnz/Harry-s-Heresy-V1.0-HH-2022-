                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Melee, Unwieldy, Specialist Weapon, Brutal (2), Charged Attacks</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Charged Attacks" id="964d-fbb5-e02-54ab" hidden="false">
              <description>Each time Endryd Haar makes attacks with this weapon, he can make Charged Attacks. If he does so, halve the total number of Attacks Endryd Haar makes (rounding up), but change the Strength characteristic of his Terrawat-pattern Power Gauntlet to &apos;x3&apos;.</description>
            </rule>
          </rules>
        </selectionEntry>
