    <entryLink name="Cassian Dracos Reborn" id="df70-ba89-d259-20b2" collective="false" hidden="true" import="false" targetId="fb8a-ab72-52ce-38f3" type="selectionEntry">
      <categoryLinks>
        <categoryLink name="HQ:" id="ccfb-acfb-0fac-4f8c" hidden="false" primary="true" targetId="4f85-eb33-30c9-8f51"/>
