      <entryLinks>
        <entryLink name="Disciple of the Flame" id="81e9-5811-0d1e-71c0" hidden="false" import="true" targetId="d554-7321-7d26-feb9" type="selectionEntry">
          <rules>
            <rule name="Disciple of the Flame (Cassian)" id="6aec-f119-f453-fa31" hidden="true" noindex="true" page="67" publicationId="d0df-7166-5cd3-89fd">
              <description>You can include this model in a Blackshields Detachment. If you do so, that Detachment must use the Pride is Our Armour and Panoply of Old (Salamanders) Oaths 

When you do so, replace this model’s Legiones Astartes (Salamanders) special rule with the Legiones Astartes (Blackshields) special rule.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="d344-d97b-4687-8a62" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="greaterThan" value="0"/>
          </conditions>
        </modifier>
