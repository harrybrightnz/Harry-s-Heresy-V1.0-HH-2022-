          <infoLinks>
            <infoLink name="Legiones Hereticus (Emperor’s Children)" id="680-ca2e-43d6-a08c" hidden="false" targetId="b9e-b2ef-86e-e52d" type="rule"/>
            <infoLink name="Master of the Legion" id="c8fd-d644-5f4a-d97c" hidden="false" targetId="c772-87ea-d49c-c7ba" type="rule"/>
            <infoLink name="Traitor" id="9dab-57b7-e275-dbbb" hidden="false" targetId="eff2-8b0e-21da-2f0d" type="rule"/>
            <infoLink name="The Stage is Set" id="3070-1171-102d-8664" hidden="false" targetId="cafc-473b-bf32-fae1" type="rule">
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="6760-f643-3a7f-970d" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
